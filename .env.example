# 复制为 .env 并填入实际值
OLLAMA_BASE=http://127.0.0.1:11434
# 聊天模型（DeepSeek 官方 API）
CHAT_MODEL=deepseek-v4-flash
# DeepSeek 官方 API Key（必填）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 向量化模型（Ollama）
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
DB_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/YOUR_DB
TOP_K=4
UPLOAD_DIR=data/uploads
